# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/casesync

# Better Auth
BETTER_AUTH_SECRET=<generate-strong-secret>
BETTER_AUTH_URL=http://localhost:3000

# Jev
JEVMODEL_API_KEY=<your-key>
JEVMODEL_BASE_URL=https://jevmodel.org
JEVMODEL_MODEL=jev-latest
JEV_ENABLED=true
AI_PROVIDER=jev

# Feature flags
OVERLAP_AUTO_ASSESS=true
