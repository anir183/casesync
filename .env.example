# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/casesync

# Better Auth
BETTER_AUTH_SECRET=<generate-strong-secret>
BETTER_AUTH_URL=http://localhost:3000

# Jev
JEVMODEL_API_KEY=<your-key>
JEVMODEL_BASE_URL=https://jevmodel.org
JEVMODEL_MODEL=jev-latest
JEV_ENABLED=true
JEV_TIMEOUT_MS=15000
JEV_MAX_RETRIES=2
JEV_COORDINATION_THRESHOLD=0.5
AI_PROVIDER=jev

# Overlap matching
INSTITUTION_FUZZY_THRESHOLD=0.85

# Feature flags
OVERLAP_AUTO_ASSESS=true
STAFF_SIGNUP_ENABLED=false
COMPLAINANT_SIGNUP_ENABLED=true
CRON_ENABLED=true

# Complaints (Stage 8)
COMPLAINT_REOPEN_DAYS=30

# SLA defaults (Stage 5)
DEFAULT_SLA_DAYS=30
PENDING_REMINDER_DAYS=7
SLA_REMINDER_DAYS=7,3,1
SLA_TIMEZONE=Asia/Kolkata

# Attachments (Stage 6)
ATTACHMENT_STORAGE_DIR=storage/attachments
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Dev seed only
SEED_PASSWORD=Passw0rd!123
