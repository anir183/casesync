{
  "name": "@casesync/api",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "seed": "bun run src/seed.ts",
    "seed:demo": "bun run src/seed.ts --demo",
    "seed:reset": "bun run src/seed.ts --reset",
    "test": "bun test",
    "seed:stress": "bun run src/seed.ts --stress",
    "seed:stress:reset": "bun run src/seed.ts --stress-reset"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "better-auth": "^1.0.0",
    "date-fns": "^4.1.0",
    "elysia": "^1.1.25",
    "mongoose": "^8.8.0",
    "node-cron": "^3.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11"
  }
}
